{
  "name": "universal-api-framework",
  "version": "0.0.0",
  "private": true,
  "description": "API testing helpers and local API smoke scaffold for BuildProveShip test frameworks",
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.performance.json && tsc -p tsconfig.k6.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc",
    "generate": "node src/codegen/cli.ts generate",
    "generate:check": "node src/codegen/cli.ts check",
    "test": "npm run build && node --test --test-concurrency=1 --test-reporter=spec dist/tests/*.test.js",
    "perf:smoke": "node performance/run.ts --profile direct-mock --workload smoke --fixture passing",
    "perf:fixture-fail": "node performance/run.ts --profile direct-mock --workload smoke --fixture failing",
    "perf:baseline": "node performance/run.ts --profile direct-mock --workload baseline --fixture passing",
    "perf:dev": "node performance/run.ts --profile dev --workload dev-smoke",
    "test:performance": "node --test --test-concurrency=1 --test-reporter=spec tests/performance/*.test.ts",
    "perf:dev:fixture-fail": "node performance/run.ts --profile dev --workload dev-smoke --fixture failing",
    "perf:dev:baseline": "node performance/run.ts --profile dev --workload dev-baseline",
    "check:guardrails": "releaseready-guardrails",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:guardrails && npm test && npm run test:performance",
    "prepare": "releaseready-hooks install"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.8",
    "@buildproveship/config": "^5.1.0",
    "@openapitools/openapi-generator-cli": "2.44.0",
    "@types/k6": "0.54.2",
    "@types/node": "22.19.0",
    "eslint": "10.15.0",
    "openapi-types": "12.1.3",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@apidevtools/openapi-schemas": "2.1.0",
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv-draft-04": "1.0.0",
    "yaml": "2.9.1"
  },
  "prettier": "@buildproveship/config/prettier",
  "license": "Apache-2.0",
  "exports": {
    "./test-data-restore/v1": {
      "types": "./dist/src/test-data-restore/index.d.ts",
      "default": "./dist/src/test-data-restore/index.js"
    }
  }
}
